GROQ_API_KEY=API_KEY
# Optional: Add a free Google AI Studio Gemini key to enable Dual-Provider AI Load Balancing (Groq + Gemini)
GEMINI_API_KEY=""
GITHUB_TOKEN=TOKEN

# Add your database URL from Supabase below:
# Connect to Postgres via the shared transaction-mode pooler (IPv4-only)
DATABASE_URL="url"

# Connect to Postgres via the shared session-mode pooler (used for migrations)
DIRECT_URL="url"

# Supabase Auth (place in apps/web/.env.local for Next.js)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# MongoDB NoSQL Evidence Store (Optional — MongoDB Atlas free M0 or local mongodb://localhost:27017)
# If omitted or unreachable, VeriSphere degrades gracefully and continues using PostgreSQL only.
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="verisphere"